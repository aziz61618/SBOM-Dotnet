<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotnetSample</RootNamespace>
    <!-- Writes packages.lock.json on restore so Trivy can read exact versions -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Don't fail the build on known-vulnerable package warnings (NU1901-NU1904) -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <!--
    Versions are intentionally OLD so the scanner has something to report:
      - outdated versions -> dotnet list package (outdated)
      - known CVEs        -> Trivy
      - licenses          -> dotnet-project-licenses
    DO NOT use these versions in real projects.
  -->
  <ItemGroup>
    <!-- CVE-2024-21907 (High), fixed in 13.0.1 -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
    <!-- CVE-2024-30105 / CVE-2024-43485, fixed in 8.0.5 -->
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    <!-- CVE-2018-8292, legacy package -->
    <PackageReference Include="System.Net.Http" Version="4.3.0" />
    <!-- Outdated, Apache-2.0 -->
    <PackageReference Include="Serilog" Version="2.10.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.0.0" />
  </ItemGroup>

</Project>
